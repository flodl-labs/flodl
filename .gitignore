# Research sweeps (elche-msf etc.) — valuable but every result needs a re-run
# before it is publishable, so the tree is kept on disk, out of git.
/research/

# Generated guide pages (built from site/_stubs/ + docs/ by site/build_guide.py).
# Two of the three channels are generated on every build and ignored:
#   site/guide/*.md    bare-path redirects to the current release series
#   site/guide/main/   the unreleased channel
# Release series (site/guide/0.8.x/ and friends) are the exception and are
# COMMITTED, because their whole purpose is to keep serving the version they
# documented after the source has moved on. That also makes them patchable in
# place: a typo in shipped docs is a normal edit, not a wait for the next
# release. Do not add a wildcard here that would swallow them.
site/guide/*.md
site/guide/main/
# Jekyll build output and bundle lock
site/_site/
site/.jekyll-cache/
site/Gemfile.lock

# libtorch variants (downloaded or built from source, or symlink to off-disk location)
/libtorch

# Local fdl config (fdl.yaml.example is committed; fdl copies it on first run)
# fdl.*.yml covers per-environment overlays (fdl.cluster.yml, fdl.vm.yml, ...)
# while keeping `fdl.*.yml.example` templates in the repo.
fdl.yaml
fdl.yml
fdl.*.yml

# Regenerated by fdl-cli on every `fdl @cluster ...` invocation; injects
# `extra_hosts:` so the container's getaddrinfo resolves remote cluster
# host names the same way the controller does.
.fdl-cluster-overlay.yml

# Local docker-compose env (per-machine: UID/GID, libtorch variant override,
# cargo job throttle). See docs/mac-apple-silicon.md for Mac users.
.env

mempalace.yaml
entities.json
/cores/

# Unreleased-channel generated files (release series are committed)
site/_includes/sidebar-main.html
